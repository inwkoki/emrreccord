{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "username":    { ".validate": "newData.isString() && newData.val().length <= 20" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "createdAt":   { ".validate": "newData.val() <= now" },
        "$other":      { ".validate": false }
      }
    },
    "encounters": {
      // Any signed-in staff device (anonymous auth) can read/write the board.
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["updatedAt"],
      "$id": {
        ".validate": "newData.hasChildren(['bed', 'updatedAt', 'by', 'status'])",
        "bed":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "complaint": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "history":   { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "exam":      { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "bedside":   { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "by":        { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'recorded')" },
        "createdAt": { ".validate": "newData.val() <= now" },
        "updatedAt": { ".validate": "newData.val() <= now" },
        "$other":    { ".validate": false }
      }
    }
  }
}
